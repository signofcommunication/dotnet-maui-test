<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TodoApp_Maui.MainPage"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header with filter buttons -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*" Padding="10">
            <Button Grid.Column="0" Text="All" 
                    Command="{Binding FilterTodosCommand}" 
                    CommandParameter="All" 
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    Margin="2" />
            <Button Grid.Column="1" Text="Pending" 
                    Command="{Binding FilterTodosCommand}" 
                    CommandParameter="Pending"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="White"
                    Margin="2" />
            <Button Grid.Column="2" Text="Completed" 
                    Command="{Binding FilterTodosCommand}" 
                    CommandParameter="Completed"
                    BackgroundColor="{StaticResource Tertiary}"
                    TextColor="White"
                    Margin="2" />
        </Grid>

        <!-- Todo List -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" 
                     Command="{Binding LoadTodosCommand}">
            <CollectionView ItemsSource="{Binding Todos}" 
                            BackgroundColor="Transparent">
                <CollectionView.EmptyView>
                    <StackLayout Padding="20" VerticalOptions="CenterAndExpand">
                        <Label Text="No todos found" 
                               HorizontalOptions="Center" 
                               Style="{StaticResource SubHeadline}"
                               TextColor="{StaticResource Gray600}" />
                        <Label Text="Tap the + button to add your first todo" 
                               HorizontalOptions="Center" 
                               TextColor="{StaticResource Gray500}" />
                    </StackLayout>
                </CollectionView.EmptyView>
                
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="15,10" ColumnDefinitions="Auto,*,Auto,Auto">
                            <!-- Completion Checkbox -->
                            <CheckBox Grid.Column="0" 
                                      IsChecked="{Binding IsCompleted}"
                                      VerticalOptions="Center">
                                <CheckBox.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleCompletedCommand}"
                                                          CommandParameter="{Binding .}" />
                                </CheckBox.GestureRecognizers>
                            </CheckBox>

                            <!-- Todo Content -->
                            <StackLayout Grid.Column="1" Margin="10,0" VerticalOptions="Center">
                                <Label Text="{Binding Title}" 
                                       FontSize="16" 
                                       FontAttributes="{Binding IsCompleted, Converter={StaticResource BoolToFontAttributesConverter}}"
                                       TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToTextDecorationsConverter}}"
                                       TextColor="{Binding IsCompleted, Converter={StaticResource BoolToColorConverter}}" />
                                <Label Text="{Binding Description}" 
                                       FontSize="12" 
                                       TextColor="{StaticResource Gray500}"
                                       IsVisible="{Binding Description, Converter={StaticResource StringToBoolConverter}}" />
                                <Label Text="{Binding CreatedDate, StringFormat='{0:MMM dd, yyyy}'}" 
                                       FontSize="10" 
                                       TextColor="{StaticResource Gray400}" />
                            </StackLayout>

                            <!-- Edit Button -->
                            <Button Grid.Column="2" 
                                    Text="Edit" 
                                    FontSize="12"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    Padding="10,5"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditTodoCommand}"
                                    CommandParameter="{Binding .}" />

                            <!-- Delete Button -->
                            <Button Grid.Column="3" 
                                    Text="Delete" 
                                    FontSize="12"
                                    BackgroundColor="{StaticResource Red}"
                                    TextColor="White"
                                    Padding="10,5"
                                    Margin="5,0,0,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteTodoCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Add Todo Button -->
        <Button Grid.Row="2" 
                Text="+ Add Todo" 
                FontSize="18"
                BackgroundColor="{StaticResource Success}"
                TextColor="White"
                Margin="20"
                Command="{Binding AddTodoCommand}" />
    </Grid>

</ContentPage>
